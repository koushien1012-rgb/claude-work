ALPHAVANTAGE_API_KEY=
FMP_API_KEY=

# SEC EDGAR requires a contact string (not a secret key) in the User-Agent header.
# Format: "YourName your@email.com"
SEC_EDGAR_CONTACT=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
CLAUDE_MODEL=

# Optional. translate.py uses the free MyMemory translation API (no key required) to
# translate English news headlines and business summaries to Japanese. Anonymous use is
# capped at 5000 chars/day; registering a free email here raises it to 50000 chars/day.
# https://mymemory.translated.net/doc/usagelimits.php
MYMEMORY_EMAIL=
